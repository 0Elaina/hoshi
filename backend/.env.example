HOSHI_APP_ENV=development
HOSHI_LOG_LEVEL=INFO
HOSHI_LOG_FILE=logs/hoshi.log
HOSHI_DB_HOST=127.0.0.1
HOSHI_DB_PORT=5432
HOSHI_DB_NAME=hoshi
HOSHI_DB_USER=
HOSHI_DB_PASSWORD=

HOSHI_ADMIN_ORIGIN=http://127.0.0.1:5173

HOSHI_REDIS_HOST=127.0.0.1
HOSHI_REDIS_PORT=6379
HOSHI_REDIS_PASSWORD=


HOSHI_JWT_SECRET=
HOSHI_JWT_ISSUER=hoshi
# JWT 有效期（单位：秒）：access 5 分钟，admin refresh 24 小时，user refresh 30 天
HOSHI_JWT_ACCESS_TTL=300
HOSHI_JWT_ADMIN_REFRESH_TTL=86400
HOSHI_JWT_USER_REFRESH_TTL=2592000

# 双桶对象存储（全空时禁用存储；启用时 endpoint、双桶与凭据 5 项须成组填写）
# 本地 RustFS 参考：HOSHI_S3_ENDPOINT_URL=http://127.0.0.1:9000
# 本地开发桶参考：HOSHI_S3_PRIVATE_BUCKET=hoshi-dev-private、HOSHI_S3_PUBLIC_BUCKET=hoshi-dev-public
HOSHI_S3_ENDPOINT_URL=
HOSHI_S3_SIGNING_ENDPOINT_URL=
HOSHI_S3_REGION=us-east-1
HOSHI_S3_PRIVATE_BUCKET=
HOSHI_S3_PUBLIC_BUCKET=
HOSHI_S3_ACCESS_KEY=
HOSHI_S3_SECRET_KEY=

# RabbitMQ 文件任务唤醒（全空时禁用；启用时 host、user、password 须成组填写）
# 本地共享实例参考：HOSHI_RABBITMQ_HOST=127.0.0.1、HOSHI_RABBITMQ_PORT=5672、HOSHI_RABBITMQ_USER=admin
HOSHI_RABBITMQ_HOST=
HOSHI_RABBITMQ_PORT=5672
HOSHI_RABBITMQ_USER=
HOSHI_RABBITMQ_PASSWORD=
HOSHI_RABBITMQ_VHOST=/

# 公开媒体基址与 CDN 清理开关（默认关闭；启用 CDN 清理时须同时启用对象存储并配置公开媒体基址）
HOSHI_PUBLIC_MEDIA_BASE_URL=
HOSHI_CDN_PURGE_ENABLED=false
